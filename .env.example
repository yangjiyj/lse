# ---- database (PostgreSQL) ----
POSTGRES_USER=lse
POSTGRES_PASSWORD=lse_dev_pw
POSTGRES_DB=lse
DATABASE_URL="postgresql://lse:lse_dev_pw@localhost:5432/lse?schema=public"  # pragma: allowlist secret

# ---- queue (Valkey / Redis protocol) ----
REDIS_URL="redis://localhost:6379"

# ---- api ----
API_PORT=8080
NODE_ENV=development
JWT_SECRET="change-me-in-prod"  # pragma: allowlist secret
JWT_EXPIRES_IN="12h"

# 生产首次安装必须显式设置强口令；系统只展示 admin 账号，不展示默认密码。
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=admin
ADMIN_PASSWORD="change-me-before-first-install"  # pragma: allowlist secret

# ---- 报告渲染器 ----
# html（默认，HTML/CSS + paged.js + 无头 chromium，完整报告排版）| pdfkit（显式选择的兼容渲染器）
# html 使用镜像内经过启动验证的 Chromium；渲染失败时明确报错，不自动切换报告样式。
REPORT_RENDERER=html
REPORT_CHROMIUM_PATH=/opt/lse-chromium/chrome

# ---- license v2 (Ed25519-JCS-B64URL). 私钥离线保管，生产默认强制授权 ----
LICENSE_PUBLIC_KEY=""
# JSON 公钥环示例：{"hxb-prod-lic-2026-01":"raw-ed25519-public-key-base64url"}
LICENSE_PUBLIC_KEYS={"lse-lic-2026":"WxiAqCV0BUqVnopcPSrOWcVlowUoz1JQtGyEUCZ2f_Y"}
LICENSE_DEPLOYMENT_ID=""
LICENSE_REVOCATION_FILE=""
# 开发环境可显式关闭；生产环境不设置时默认 true。
LICENSE_ENFORCE=true

# ---- engines (M6 接入后填写) ----
PYTHON_JUDGE_URL="http://localhost:8000"

# 智能体安全网关日志分析：用于调用网关 /admin/v1/eval-integration/* 内部接口。
# 生产环境填 NEWAPI_EVAL_INTEGRATION_TOKEN，值应与网关 JJD_INTERNAL_API_SECRET 对齐。
NEWAPI_EVAL_INTEGRATION_TOKEN=
# 填网关对外暴露的 /admin/v1 入口（通常是 gateway-core:8080/admin/v1），
# 不要填仅绑定 127.0.0.1 的 control-plane:8081，除非两套 compose 明确加入同一网络。
NEWAPI_CONTROL_PLANE_BASE_URL=
# 留空=fail-closed；只填写精确 origin/host，禁止通过未登记的私网/loopback 目标。
GATEWAY_CONTROL_PLANE_ALLOWLIST=

# 与网关相同的 LSE 关联证据 HMAC keyring；切换 key 时保留旧 kid 一段时间再删除。
LSE_CORRELATION_HMAC_KEYS=
LSE_CORRELATION_HMAC_ACTIVE_KID=
NEWAPI_TENANT_ID=tenant_default

# ---- 智能体安全网关组合部署（可选）----
# 当评估平台和智能体安全网关在同一台 Docker 主机上分别由 compose 管理时，
# 启用下面的 COMPOSE_FILE，让 lse-api/lse-worker 加入网关内部网络。
# 然后在「智能体安全网关日志源」里填写：
# 网关地址 / IP：http://control-plane:8081
# Tenant ID：tenant_default（或网关实际租户）
# COMPOSE_FILE=docker-compose.yml:docker-compose.gateway.yml
# 如果网关 compose 项目名不同，修改 docker-compose.gateway.yml 里的 external network name。

# ---- 模型文件扫描 ----
# 宿主机上存放模型的目录，compose 以只读方式挂载到 api/worker 容器的 /models（目录需存在，可放 HF 缓存）。
# 同一个变量也会传给 api/worker，页面据此告诉用户“模型该放到服务器的哪个目录”。
# MODEL_SCAN_HOST_DIR=/opt/lse/models
# 目录扫描白名单根（容器内路径，逗号分隔），与管理员在「扫描配置」里添加的根取并集
# MODEL_SCAN_ROOTS=/models
# 模型文件上传的可选硬上限（字节）；0 或不设置表示不限制，只受服务器磁盘剩余空间约束
# MODEL_SCAN_UPLOAD_MAX_BYTES=0
