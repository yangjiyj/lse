# 依赖与构建产物（镜像内重新安装/构建）
**/node_modules
**/dist
**/.turbo
**/.vite
**/*.tsbuildinfo
.pnpm-store
**/coverage
**/src/generated

# 版本控制与本地配置
.git
.gitignore
.editorconfig

# 机密与本地环境（容器内由 compose 注入）
.env
.env.*
*.pem
*.key
license.json

# 文档 / 容器定义（无需进入构建上下文）
docs
README.md
THIRD_PARTY_NOTICES.md
Dockerfile
docker-compose.yml
.dockerignore
.prettier*

# 杂项
*.log
logs
.DS_Store
.idea
.vscode

# 本地备份文件，绝不进镜像(防泄漏本地环境文件)
*.bak
*.bak*
*.orig

# Codex/本地工作副本，绝不进入应用镜像或离线交付物
work
.worktrees

# Release runtime excludes development fixtures and integration-only launchers.
apps/**/test
apps/**/tests
apps/api/scripts
test
deploy
scripts/*
!scripts/report-renderer-smoke.ts

**/*.test.*
**/fixtures
