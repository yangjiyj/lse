}

// ============================= AI 服务安全核验 =============================
model ServiceAssuranceRun {
  id                       String                         @id @default(uuid())
  /// 所属租户
  tenantId                 String?
  /// 可空：核验可独立发起，需要纳入报告时再关联评估任务（linkedAt 记录关联时间）。
  taskId                   String?
  task                     EvalTask?                      @relation(fields: [taskId], references: [id], onDelete: Restrict)
  linkedAt                 DateTime?
  createdById              String?
  createdBy                User?                          @relation("ServiceAssuranceRunCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  mode                     ServiceAssuranceMode
  targetKind               ServiceAssuranceTargetKind
  targetName               String
  normalizedTarget         String?
  scopePolicyRef           String
  scopePolicySnapshot      Json?
  scopePolicyDigest        String?
  credentialRef            String?
  authorizationConfirmed   Boolean                        @default(false)
  authorizationConfirmedAt DateTime?
  status                   ServiceAssuranceRunStatus      @default(PENDING)
  coverageStatus           ServiceAssuranceCoverageStatus @default(NOT_READY)
  failureCode              String?
  failureMessage           String?
  requestBudget            Json
  rulesetVersion           String?
  rulesetDigest            String?
  vulnerabilityDbVersion   String?
  vulnerabilityDbDigest    String?
  engineVersions           Json?
  startedAt                DateTime?
  endedAt                  DateTime?
  canceledAt               DateTime?
  retestOfRunId            String?
  retestOfRun              ServiceAssuranceRun?           @relation("ServiceAssuranceRunRetest", fields: [retestOfRunId], references: [id], onDelete: SetNull)
  retests                  ServiceAssuranceRun[]          @relation("ServiceAssuranceRunRetest")
  fixedAssessments         VulnerabilityAssessment[]      @relation("AssuranceAssessmentFixedByRun")
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt

  assets      ServiceAsset[]
  components  ServiceComponent[]
  assessments VulnerabilityAssessment[] @relation("AssuranceAssessmentRun")
  evidence    ServiceEvidence[]

  @@index([taskId, createdAt])
  @@index([taskId, status])
  @@index([createdById, createdAt])
  @@index([retestOfRunId])
  @@index([tenantId])
  @@map("service_assurance_runs")
}

model ServiceAsset {
