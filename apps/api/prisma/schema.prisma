// ============================= 报告 =============================
model Report {
  id                String       @id @default(uuid())
  /// 所属租户
  tenantId          String?
  /// 组合报告（kind = combined）不挂单个任务，为空；包含的任务见 reportTasks。
  taskId            String?
  task              EvalTask?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  evaluatedTargetId String?
  evaluatedTarget   ModelTarget? @relation("ReportEvaluatedTarget", fields: [evaluatedTargetId], references: [id], onDelete: SetNull)
  title             String
  format            String       @default("markdown")
  kind              String       @default("safety_overview")
  content           String
