// 大模型安全评估平台 —— 数据模型（一期）
// 业务代码只消费 EngineResult 归一化契约，不直接依赖任一开源引擎私有结构。
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================= 枚举 =============================
enum Severity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EvalTaskStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELED
}

enum EngineRunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  ERROR
  SKIPPED
}

enum FindingReviewStatus {
  UNREVIEWED
  NEEDS_REVIEW
  CONFIRMED
  FALSE_POSITIVE
  ACCEPTED_RISK
}

enum FindingRemediationStatus {
  OPEN
  IN_PROGRESS
  READY_FOR_RETEST
  VERIFIED_CLOSED
  REOPENED
  NOT_APPLICABLE
}

enum ModelCallStatus {
  SUCCESS
  ERROR
}

enum Verdict {
  PASS
  FAIL
  UNKNOWN
  ERROR
}

enum QuestionType {
  COMPLIANCE
  PROMPT_INJECTION
  SHOULD_REFUSE
  GENERAL
}

enum ImportStatus {
  PENDING
  SUCCESS
  PARTIAL
  FAILED
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  INVALID
  REVOKED
}

enum TargetType {
  MODEL
  AGENT
  AGENT_API
  PLATFORM_APP
  ENDPOINT_AGENT
  PUBLIC_AGENT
  MCP_OPENAPI
  GATEWAY_LOG
  JUDGE
}

enum ServiceAssuranceMode {
  SAFE
  DEEP
  SBOM
}

enum ServiceAssuranceTargetKind {
  ENDPOINT
  OPENAPI
  MCP
  SBOM
}

enum ServiceAssuranceRunStatus {
  PENDING
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELED
}

enum ServiceAssuranceCoverageStatus {
  COMPLETE
  INCOMPLETE
  NOT_READY
}

enum AssuranceImpactStatus {
  UNDER_INVESTIGATION
  AFFECTED
  NOT_AFFECTED
  FIXED
}

enum AssuranceEvidenceLevel {
  LEAD
  VERSION_MATCH
  CONFIG_MATCH
  ACTIVE_VERIFIED
}

enum AssuranceEvidenceVisibility {
  CUSTOMER
  TECHNICAL
  AUDIT_ONLY
}

enum AssurancePriority {
  P0
  P1
  P2
  P3
  UNKNOWN
}

// ============================= 租户 =============================
/// 多租户：每个用户属于一个租户；isPlatform 为平台租户（原有数据与平台管理员所在）。
/// 各业务表的 tenantId 是普通列（不建 Prisma 关系），由 db.ts 的查询扩展按当前租户自动过滤与填充，
/// 后台任务写入时由数据库触发器从父对象继承（见迁移 20261106120000_multi_tenant）。
model Tenant {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  isPlatform  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@map("tenants")
}

// ============================= 用户 / 角色 / 权限 =============================
/// 自助注册审核状态：NONE 为存量用户和管理员新建的用户
enum RegistrationStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                 String             @id @default(uuid())
  /// 所属租户（平台管理员也有一个本属租户：平台租户）
  tenantId           String             @default("00000000-0000-4000-8000-000000000001")
  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  username           String             @unique
  passwordHash       String
  displayName        String
  email              String?
  /// 自助注册填写的手机号与单位
  phone              String?
  organization       String?
  /// 所属组织（2.9.3 组织架构），与上面自助注册填的「单位」无关
  organizationId     String?
  org                Organization?      @relation("UserOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  registrationStatus RegistrationStatus @default(NONE)
  isActive           Boolean            @default(true)
  isBuiltin          Boolean            @default(false)
  lastLoginAt        DateTime?
  preferences        Json?
  // 安全设置：登录失败计数、锁定截止、改密时间（密码强制更新）、最近活跃（超时登出）
  failedLoginCount   Int                @default(0)
  lockedUntil        DateTime?
  passwordChangedAt  DateTime?          @default(now())
  /// 须改密：管理员新建、管理员重置、审核通过的注册用户为 true，自己改密后清除
  mustChangePassword Boolean            @default(false)
  lastActiveAt       DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  roles                        UserRole[]
  uploadedLicenses             License[]                  @relation("LicenseUploadedBy")
  createdTargets               ModelTarget[]              @relation("TargetCreatedBy")
  createdSets                  QuestionSet[]              @relation("SetCreatedBy")
  imports                      QuestionImport[]           @relation("ImportUploadedBy")
  createdTasks                 EvalTask[]                 @relation("TaskCreatedBy")
  generatedReports             Report[]                   @relation("ReportGeneratedBy")
  auditLogs                    AuditLog[]                 @relation("AuditActor")
  updatedSystemSettings        SystemSetting[]            @relation("SystemSettingUpdatedBy")
  serviceAssuranceRuns         ServiceAssuranceRun[]      @relation("ServiceAssuranceRunCreatedBy")
  reviewedAssuranceAssessments VulnerabilityAssessment[]  @relation("AssuranceAssessmentReviewedBy")
  createdStandardRevisions     StandardQuestionRevision[] @relation("StandardRevisionCreatedBy")
  reviewedStandardQuestions    StandardQuestionReview[]   @relation("StandardQuestionReviewReviewer")
  publishedStandardReleases    StandardBankRelease[]      @relation("StandardBankReleasePublishedBy")
  createdStandardRuns          StandardRun[]              @relation("StandardRunCreatedBy")
  standardJudgments            StandardJudgment[]         @relation("StandardJudgmentBy")
  generatedStandardReports     StandardReport[]           @relation("StandardReportGeneratedBy")
  createdEvalPlans             EvalPlan[]                 @relation("EvalPlanCreatedBy")
  modelFileScans               ModelFileScan[]            @relation("ModelFileScanCreatedBy")
  modelFileUploads             ModelFileUpload[]          @relation("ModelFileUploadCreatedBy")
  findingFrameworkMappings     FindingFrameworkMapping[]
  fleetCodesCreated            FleetEnrollmentCode[]      @relation("FleetCodeCreatedBy")
  fleetJobsRequested           FleetEvalJob[]             @relation("FleetJobRequestedBy")
  fleetJobsApproved            FleetEvalJob[]             @relation("FleetJobApprovedBy")
  supportTickets               SupportTicket[]            @relation("SupportTicketCreatedBy")
  supportTicketReplies         SupportTicketReply[]       @relation("SupportTicketReplyAuthor")
  toolsCreated                 Tool[]                     @relation("ToolCreatedBy")
  toolVersionsCreated          ToolVersion[]              @relation("ToolVersionCreatedBy")
  toolManualsCreated           ToolManual[]               @relation("ToolManualCreatedBy")
  toolDownloads                ToolDownload[]             @relation("ToolDownloadUser")

  @@index([tenantId])
  @@index([organizationId])
  @@map("users")
}

/// 登录页访问量与安装包下载量：按北京时间切日，每天一行
model PlatformDailyStat {
  date      DateTime @id @db.Date
  visits    Int      @default(0)
  downloads Int      @default(0)

  @@map("platform_daily_stats")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isBuiltin   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "model_target:create"
  name        String
  group       String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ============================= License =============================
model SystemSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedBy   User?    @relation("SystemSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

model License {
  id                 String        @id @default(uuid())
  raw                String // 上传的 license.json 原文
  payload            Json
  subject            String?
  issuedAt           DateTime?
  expiresAt          DateTime?
  machineFingerprint String?
  status             LicenseStatus @default(ACTIVE)
  isActive           Boolean       @default(true)
  uploadedById       String?
  uploadedBy         User?         @relation("LicenseUploadedBy", fields: [uploadedById], references: [id])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@map("licenses")
}

// ============================= 模型对象 =============================
model ModelTarget {
  id                        String     @id @default(uuid())
  /// 所属租户（空 = 平台共享）
  tenantId                  String?
  name                      String
  provider                  String // openai-compatible | deepseek | tongyi | boflow ...
  targetType                TargetType @default(MODEL)
  baseUrl                   String
  apiKey                    String
  model                     String
  extraHeaders              Json?
  defaultParams             Json?
  accessConfig              Json?
  agentConfig               Json?
  isGlobal                  Boolean    @default(true)
  isActive                  Boolean    @default(true)
  lastTestedAt              DateTime?
  lastTestStatus            String?
  /// RAG 专项评估：被测对象声明为 RAG 应用；ragOptions 存引用来源 JSON 路径与知识库上传接口配置。
  isRag                     Boolean    @default(false)
  ragOptions                Json?
  /// RAG 越权检测用的受限库上传凭据（AES-256-GCM 密文，永不回显）。
  ragRestrictedUploadSecret String?
  createdById               String?
  createdBy                 User?      @relation("TargetCreatedBy", fields: [createdById], references: [id])
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt
  /// W6b 多模态越狱：评估对象是否声明支持图片输入（OpenAI 兼容 image_url）。
  supportsVision            Boolean    @default(false)

  evalTasks        EvalTask[]
  evalResults      EvalResult[]
  evaluatedReports Report[]           @relation("ReportEvaluatedTarget")
  evalPlans        EvalPlan[]
  modelFileScans   ModelFileScan[]
  ragEvalRuns      RagEvalRun[]
  fingerprints     ModelFingerprint[]
  ledgerAssets     LedgerAsset[]

  @@unique([tenantId, name])
  @@index([targetType])
  @@index([tenantId])
  @@map("model_targets")
}

// ============================= 题库 =============================
model QuestionSet {
  id          String       @id @default(uuid())
  /// 所属租户（空 = 平台共享）
  tenantId    String?
  name        String
  description String?
  type        QuestionType @default(GENERAL)
  tags        String[]
  source      String? // 来源数据集 / 上传 / 内置
  language    String? // 题集主语言（生成集必填，导入集可空）
  isBuiltin   Boolean      @default(false)
  /// 自建库可禁用：禁用后不能再用来建任务，已有任务不受影响；内置库始终启用
  enabled     Boolean      @default(true)
  // 攻击种子泛化生成的题库：记录测试领域、绑定标准、场景与生成来源。
  metadata    Json?
  createdById String?
  createdBy   User?        @relation("SetCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  questions Question[]
  imports   QuestionImport[]
  taskLinks EvalTaskQuestionSet[]
  byoImages ByoImage[]

  @@index([tenantId])
  @@map("question_sets")
}

// 攻击种子泛化的测试领域（可选已有领域或新建领域）。
model TestDomain {
  id          String   @id @default(uuid())
  /// 所属租户（空 = 平台内置，各租户只读）
  tenantId    String?
  name        String
  description String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("test_domains")
}

model Question {
  id               String       @id @default(uuid())
  /// 所属租户（空 = 平台共享）
  tenantId         String?
  questionSetId    String
  questionSet      QuestionSet  @relation(fields: [questionSetId], references: [id], onDelete: Cascade)
  externalId       String?
  content          String
  expectedBehavior String?
  category         String?
  type             QuestionType @default(GENERAL)
  severity         Severity?
  referenceAnswer  String?
  language         String       @default("zh")
  shouldRefuse     Boolean      @default(false)
  tags             String[]
  metadata         Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  results           EvalResult[]
  findings          Finding[]
  wrongAnswers      WrongAnswer[]
  standardRevisions StandardQuestionRevision[] @relation("QuestionStandardRevisions")
  evalTaskPins      EvalTaskQuestion[]

  @@index([questionSetId, language])
  @@index([tenantId])
  @@map("questions")
}

model QuestionImport {
  id            String       @id @default(uuid())
  questionSetId String?
  questionSet   QuestionSet? @relation(fields: [questionSetId], references: [id], onDelete: SetNull)
  filename      String
  format        String // xlsx | csv
  templateType  String // compliance | prompt_injection | should_refuse | general
  totalRows     Int          @default(0)
  importedRows  Int          @default(0)
  failedRows    Int          @default(0)
  status        ImportStatus @default(PENDING)
  errorReport   Json?
  uploadedById  String?
  uploadedBy    User?        @relation("ImportUploadedBy", fields: [uploadedById], references: [id])
  createdAt     DateTime     @default(now())

  @@map("question_imports")
}

// ============================= GB/T 45654 标准专项 =============================
// 题目版本、发布版、运行和判定均为追加/快照语义，避免旧题库编辑污染历史证据。
model StandardQuestionRevision {
  id                     String    @id @default(uuid())
  questionId             String?
  question               Question? @relation("QuestionStandardRevisions", fields: [questionId], references: [id], onDelete: SetNull)
  version                Int       @default(1)
  content                String
  expectedBehavior       String?
  category               String?
  primaryCategory        String?
  secondaryCategories    String[]
  nonRefusalTopic        String?
  language               String    @default("zh")
  modality               String    @default("text")
  purpose                String?
  source                 String?
  standardProfileId      String
  standardProfileVersion String
  contentHash            String
  createdById            String?
  createdBy              User?     @relation("StandardRevisionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt              DateTime  @default(now())

  reviews      StandardQuestionReview[]
  releaseItems StandardBankReleaseItem[]

  @@unique([questionId, version])
  @@index([standardProfileId, language, modality])
  @@index([contentHash])
  @@map("standard_question_revisions")
}

model StandardQuestionReview {
  id            String                   @id @default(uuid())
  revisionId    String
  revision      StandardQuestionRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  reviewerId    String
  reviewer      User                     @relation("StandardQuestionReviewReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  decision      String
  reason        String?
  correctionRef String?
  createdAt     DateTime                 @default(now())

  @@index([revisionId, createdAt])
  @@map("standard_question_reviews")
}

model StandardBankRelease {
  id             String    @id @default(uuid())
  /// 所属租户（空 = 平台发布的标准题集，各租户可用）
  tenantId       String?
  profileId      String
  profileVersion String
  name           String
  language       String    @default("zh")
  modalities     String[]
  status         String    @default("DRAFT")
  counts         Json?
  validation     Json?
  overallHash    String?
  publishedAt    DateTime?
  publishedById  String?
  publishedBy    User?     @relation("StandardBankReleasePublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items StandardBankReleaseItem[]
  runs  StandardRun[]

  @@index([profileId, status])
  @@index([tenantId])
  @@map("standard_bank_releases")
}

model StandardBankReleaseItem {
  id              String                   @id @default(uuid())
  releaseId       String
  release         StandardBankRelease      @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  revisionId      String
  revision        StandardQuestionRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  bankType        String
  primaryCategory String?
  nonRefusalTopic String?
  position        Int
  createdAt       DateTime                 @default(now())

  samples StandardSample[]

  @@unique([releaseId, revisionId])
  @@unique([releaseId, bankType, position])
  @@index([releaseId, bankType])
  @@map("standard_bank_release_items")
}

// ============================= 评估任务 =============================
model EvalTask {
  id                 String         @id @default(uuid())
  /// 所属租户
  tenantId           String?
  name               String
  description        String?
  status             EvalTaskStatus @default(PENDING)
  modelTargetId      String
  modelTarget        ModelTarget    @relation(fields: [modelTargetId], references: [id])
  engines            String[] // ["ai-infra-guard","deepeval","llm-guard"]
  dimensions         String[] // 评测维度
  concurrency        Int            @default(4)
  totalQuestions     Int            @default(0)
  /// 抽样评测：从所选样本库按分类分层抽取的题数（空 = 全量）；种子保证可复现。
  sampleSize         Int?
  sampleSeed         String?
  processedQuestions Int            @default(0)
  passedCount        Int            @default(0)
  failedCount        Int            @default(0)
  errorCount         Int            @default(0)
  progress           Float          @default(0)
  startedAt          DateTime?
  finishedAt         DateTime?
  createdById        String?
  createdBy          User?          @relation("TaskCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  questionSets              EvalTaskQuestionSet[]
  logs                      EvalTaskLog[]
  results                   EvalResult[]
  findings                  Finding[]
  remediationRetestFindings Finding[]             @relation("FindingRemediationRetestTask")
  policySuggestions         PolicySuggestion[]    @relation("PolicySuggestionSourceTask")
  policySuggestionRetests   PolicySuggestion[]    @relation("PolicySuggestionRetestTask")
  wrongAnswers              WrongAnswer[]
  engineRuns                EngineRun[]
  reports                   Report[]
  serviceAssuranceRuns      ServiceAssuranceRun[]
  standardRun               StandardRun?          @relation("EvalTaskStandardRun")
  ragEvalRun                RagEvalRun?           @relation("EvalTaskRagEvalRun")
  /// 多模型同批次评测：同一次发起的多个任务共用一个批次号。
  batchId                   String?
  /// 评估计划触发生成的任务关联计划；手动发起的任务为空。
  planId                    String?
  plan                      EvalPlan?             @relation(fields: [planId], references: [id], onDelete: SetNull)
  planRuns                  EvalPlanRun[]
  /// 失败用例复测：父任务与复测模式（FAILED_ONLY）；普通任务为空。
  parentTaskId              String?
  parentTask                EvalTask?             @relation("EvalTaskRetestParent", fields: [parentTaskId], references: [id], onDelete: SetNull)
  retestTasks               EvalTask[]            @relation("EvalTaskRetestParent")
  retestMode                String?
  /// 显式题目冻结清单：非空时执行器只跑这些题（仍限定在关联样本库内），并跳过抽样。
  pinnedQuestions           EvalTaskQuestion[]
  /// 任务前模型指纹比对结果：{status,similarity,threshold,baselineId,fingerprintId,reason}
  fingerprintCheck          Json?
  /// 暂停（2.4.2）：执行器停下来的时间；不为空表示下次执行是接续
  pausedAt                  DateTime?
  /// 暂停时的执行器状态 { engineAccum, redTeamLaps }
  pauseState                Json?
  /// 已请求暂停、执行器还没停下（页面显示「暂停中」）；停下、撤销暂停、停止、重评、结束时清空
  pauseRequestedAt          DateTime?

  @@index([batchId])
  @@index([planId, createdAt])
  @@index([parentTaskId])
  @@index([tenantId])
  @@map("eval_tasks")
}

model EvalTaskQuestion {
  taskId     String
  questionId String
  task       EvalTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([taskId, questionId])
  @@index([questionId])
  @@map("eval_task_questions")
}

// ============================= 评估计划 =============================
/// 评估计划：发起任务参数快照 + cron 调度（BullMQ Job Scheduler）+ 启停。
model EvalPlan {
  id                 String        @id @default(uuid())
  /// 所属租户
  tenantId           String?
  name               String
  description        String?
  targetId           String
  target             ModelTarget   @relation(fields: [targetId], references: [id], onDelete: Restrict)
  /// 发起评估任务参数快照（与 POST /api/eval-tasks 同一校验 schema，modelTargetId 以 targetId 为准）。
  templateParams     Json
  cron               String
  timezone           String        @default("Asia/Shanghai")
  enabled            Boolean       @default(true)
  minIntervalMinutes Int           @default(60)
  lastTriggeredAt    DateTime?
  lastSkipReason     String?
  createdById        String?
  createdBy          User?         @relation("EvalPlanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  tasks              EvalTask[]
  runs               EvalPlanRun[]
  gates              GateRule[]

  @@index([targetId])
  @@index([tenantId])
  @@map("eval_plans")
}

/// 评估计划运行记录：每次触发（手动/调度/CI）一条，跳过也记录原因。
model EvalPlanRun {
  id          String    @id @default(uuid())
  planId      String
  plan        EvalPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  taskId      String?
  task        EvalTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  /// manual | schedule | ci
  triggeredBy String
  /// triggered | skipped
  status      String
  reason      String?
  actorId     String?
  createdAt   DateTime  @default(now())

  @@index([planId, createdAt])
  @@index([taskId])
  @@map("eval_plan_runs")
}

model BatchEvaluation {
  id                 String                  @id @default(uuid())
  /// 所属租户
  tenantId           String?
  name               String
  status             EvalTaskStatus          @default(PENDING)
  createdById        String
  strategy           String                  @default("ROUND_ROBIN")
  judgeMode          String                  @default("MODEL")
  judgeTargetId      String?
  judgeFingerprint   String?
  judgeSnapshot      Json?
  sampleCount        Int
  seed               String
  samplePlanHash     String
  policyVersion      String
  concurrency        Int                     @default(4)
  targetConcurrency  Int                     @default(2)
  batchSize          Int                     @default(50)
  rpm                Int                     @default(600)
  maxAttempts        Int                     @default(3)
  maxRequests        Int
  requestsUsed       Int                     @default(0)
  maxDurationMinutes Int                     @default(1440)
  callbackUrl        String?
  nextRunIndex       Int                     @default(0)
  stopReason         String?
  leaseOwner         String?
  leaseUntil         DateTime?
  startedAt          DateTime?
  finishedAt         DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
