// ============================= 引擎判定（归一化）=============================
model Finding {
  id                            String                   @id @default(uuid())
  /// 所属租户
  tenantId                      String?
  taskId                        String
  task                          EvalTask                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
